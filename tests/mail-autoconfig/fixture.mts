import { createRequire } from "node:module";
import { createServer } from "node:http";
import { DomainService } from "../../apps/api/src/modules/domains/service.js";
import { mailAutoconfigRoutes } from "../../apps/api/src/modules/mail/autoconfig.js";
const require = createRequire(new URL("../../apps/api/package.json", import.meta.url));
const Fastify = require("fastify");
const directory = process.argv[2];
if (!directory) throw new Error("Fixture directory required");
process.chdir(directory);
const domain = { id: "d1", hostname: "example.test", parentId: null, status: "ACTIVE", sslEnabled: true, certificate: { type: "CUSTOM", forceHttps: false }, project: { id: "project12345", name: "Fixture", type: "NODEJS", status: "RUNNING", port: 3000 } };
const app = Fastify();
app.decorate("prisma", { domain: { findFirst: async ({ where }) => domain.status === "ACTIVE" && where.hostname === domain.hostname && where.status === "ACTIVE" && where.parentId === null ? { hostname: domain.hostname } : null } });
await app.register(mailAutoconfigRoutes);
await app.listen({ host: "0.0.0.0", port: 5000 });
const website = createServer((_request, response) => response.end("project website"));
await new Promise(resolve => website.listen(3000, "0.0.0.0", resolve));
const service = new DomainService({} as never);
service.syncTraefikRouter(domain as never);
process.on("SIGUSR1", () => { domain.sslEnabled = false; service.syncTraefikRouter(domain as never); });
process.on("SIGUSR2", () => { domain.status = "DELETED"; service.removeTraefikRouter(domain.id); });
process.on("SIGTERM", async () => { website.close(); await app.close(); process.exit(0); });
console.log("fixture ready");
