# Nginx site config for no-build PHP projects (F5.21).
# Generated by docker_manager.py -- do NOT edit manually.
# `location /` falls back to index.php for any URI that isn't a real file/
# dir -- the standard front-controller pattern most real PHP apps need
# (WordPress pretty permalinks, Laravel-style routing, etc.), including a
# WordPress site migrated in-place by a Duplicator-style installer. This
# does NOT break direct access to a real file like installer.php: try_files
# matches an existing file on its first check and never reaches the
# index.php fallback. A project with no index.php at all still gets a clean
# 404 for a missing path, via the .php location's own try_files guard below.

# Traefik terminates TLS at the edge and always proxies to this container
# over plain HTTP -- PHP-FPM never sees a real TLS connection, so $_SERVER
# ['HTTPS'] is unset even on an https:// request. Without this, anything
# that checks is_ssl() (WordPress's admin/login HTTPS enforcement, a
# migrated site's stored https:// siteurl, app-level HTTPS redirects, etc.)
# sees "this is HTTP", tries to redirect to https, and loops forever since
# every retried request looks like HTTP again. Translate Traefik's
# X-Forwarded-Proto into the fastcgi HTTPS param PHP actually checks.
map $http_x_forwarded_proto $fastcgi_https {
    default "";
    https "on";
}

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    # Migration/backup archives (e.g. Duplicator) commonly exceed the
    # default 1m limit and WordPress's 64m.
    client_max_body_size 512m;

    # The docroot is the whole project directory, which also holds the
    # generated deploy/ files and whatever dot files the repository has
    # (.git, .env, ...). None of that is content. Only the exact deploy/
    # directory is private, and /.well-known/ stays reachable. nginx decodes
    # and normalises the URI before matching, so encoded and dot-segment
    # spellings are caught too; ^~ makes the deploy rule win over the regex
    # locations, and the dot rule comes before the PHP handler so a dot file
    # can never be executed.
    location = /deploy { return 404; }
    location ^~ /deploy/ { return 404; }
    location ~ /\.(?!well-known(/|$)) { return 404; }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        # {{app_upstream}} is this project's own unique container name, not
        # the bare "app" service name -- Compose aliases services by their
        # plain name on every network they join, including the shared
        # external traefik-net, so "app" resolves ambiguously across
        # multiple no-build-PHP/WordPress projects deployed at once (found
        # live: nginx randomly proxied to a DIFFERENT project's php-fpm).
        fastcgi_pass {{app_upstream}}:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $fastcgi_https;
        # nginx's 60s default cuts off exactly the kind of long-running work
        # this feature exists for -- a migration installer (e.g. Duplicator)
        # extracting tens of thousands of files runs well past that.
        fastcgi_connect_timeout 300s;
        fastcgi_send_timeout 300s;
        fastcgi_read_timeout 300s;
    }

    location ~* \.(jpg|jpeg|png|gif|webp|css|js|ico|svg|woff|woff2)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }
}
