# Vexlyx API — Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://vexlyx:vexlyx_dev@localhost:5432/vexlyx_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth & Encryption (F1.7)
SESSION_SECRET=change-me-to-a-random-32-char-string-in-production
# Dedicated 32+ char key for everything encrypted at rest (AES-256-GCM): env vars,
# DB / SFTP passwords, 2FA secrets, GitHub App secrets, TLS private keys.
# Outside production an unset key falls back to SESSION_SECRET.
# Required in production and must differ from SESSION_SECRET (#69).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-32-char-string-in-production
# Only for installs that previously ran WITHOUT ENCRYPTION_KEY: keeps old data
# readable while you run `pnpm db:reencrypt`. Unset it afterwards.
# ENCRYPTION_KEY_LEGACY_FALLBACK=true
# Off by default (F5.8) — panel is closed, admins/resellers add users from
# /users. Set to true only if you want the public /register form enabled.
ALLOW_REGISTRATION=false

# Require TOTP 2FA for ADMIN role at login (F5.17). "false" = optional for everyone.
REQUIRE_ADMIN_2FA=false

# Session cookie Domain attribute (F5.1). Required when the dashboard and
# API are served from different subdomains (e.g. production: dashboard on
# panel.example.com, API on api.panel.example.com) — set to the shared
# parent domain (e.g. panel.example.com) so both subdomains can read the
# session cookie. Leave unset for local dev.
# COOKIE_DOMAIN=panel.example.com

# Git Integration (F1.3)
# Root directory where cloned project repos are stored on disk.
# Dev default creates ./workspaces/projects relative to the API process.
PROJECTS_DIR=./workspaces/projects

# Root directory where per-project SSH key pairs are stored on disk.
# Dev default creates ./workspaces/keys relative to the API process.
SSH_KEYS_DIR=./workspaces/keys

# Base URL of this API — used to generate webhook callback URLs.
API_BASE_URL=http://localhost:5000

# Build Integration (F1.4)
# Prefix used for Docker image names built by Nixpacks.
# Images are named: <prefix>-<projectId>  e.g. vexlyx-cm9xyz123
# Nixpacks must be installed and available in PATH on the server.
NIXPACKS_IMAGE_PREFIX=vexlyx

# No-Build PHP Hosting (F5.21)
# Fixed PHP-FPM image (docker/php-fpm/Dockerfile, built at install time)
# that composer-less PHP projects deploy against instead of a per-project
# Nixpacks build.
PHP_FPM_IMAGE=vexlyx-php-fpm:8.3

# Deploy Integration (F1.5)
# Base domain for per-project Traefik hostnames: {project-name}.{BASE_DOMAIN}
# In development, vexlyx.localhost works natively in Chrome/Edge (no DNS needed).
# In production, set to your server's domain e.g. apps.yourdomain.com
BASE_DOMAIN=vexlyx.localhost

# Default Docker container memory limit (e.g. 128m, 256m, 512m)
DEPLOY_MEMORY_LIMIT=128m

# Dynamic host-port range used when a project has no explicit port set.
# Each container is allocated a unique port in this range.
DEPLOY_PORT_RANGE_START=8100
DEPLOY_PORT_RANGE_END=8999

# Database Provisioning (F2.6)
POSTGRES_CONTAINER_NAME=vexlyx-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vexlyx
POSTGRES_PASSWORD=vexlyx_dev
MYSQL_CONTAINER_NAME=vexlyx-mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=vexlyx_mysql_root
# Browser-facing Adminer URL. Development defaults to http://localhost:8088
# when omitted. Production leaves Adminer disabled unless this is explicitly
# set to a protected HTTPS endpoint (never expose Adminer without access control).
# ADMINER_URL=https://db-admin.example.com
# On a server install, system/scripts/enable-adminer.sh sets this (plus the
# Traefik basic-auth entry) for you; see docs/dev/database-provisioning.md.

# Email — Dovecot IMAP Server (F4.2)
# Host/ports used by the API to probe Dovecot's daemon status.
IMAP_HOST=127.0.0.1
IMAP_PORT=143
IMAPS_PORT=993

# Webmail — Roundcube (F4.4)
# WEBMAIL_URL is the browser-facing link surfaced in the dashboard's Webmail tab.
WEBMAIL_URL=http://localhost:8089
WEBMAIL_PORT=8089
WEBMAIL_CONTAINER_NAME=vexlyx-roundcube

# DNS Records & Public IP Onboarding (F5.9)
# Set automatically by the installer in production — leave unset in dev.
# PANEL_DOMAIN=panel.example.com
# PUBLIC_IP=203.0.113.10
# HOSTED_MAIL_HOSTNAME=mail.panel.example.com
# HOSTED_MAIL_DOMAIN=panel.example.com

# Comma-separated nameservers users point their domain at to have Vexlyx host
# their DNS (F5.23). Defaults to ns1.vexlyx.com,ns2.vexlyx.com.
# DNS_NAMESERVERS=ns1.example.com,ns2.example.com

# Python interpreter used to spawn system/python/*.py scripts (F5.14).
# Defaults to "python" on Windows / "python3" elsewhere — only set this if
# that default isn't the right interpreter on your host (e.g. a venv).
# PYTHON_BIN=python3

# File Manager archive limits (F5.24) — guards for extract / compress.
# FILE_ARCHIVE_MAX_BYTES=2147483648
# FILE_ARCHIVE_MAX_ENTRIES=50000
# FILE_ARCHIVE_MAX_RATIO=100

# System email (F5.23) — password resets, security alerts, quota/backup notices.
# Works with zero configuration: in production mail is relayed through the
# bundled Postfix as notifications@MAIL_DOMAIN. In development it is printed to the
# API log (EMAIL_TRANSPORT=log) so you can copy reset links without a mail server.
# EMAIL_ENABLED=true
# EMAIL_TRANSPORT=smtp            # smtp | log (log is refused in production)
# MAIL_DOMAIN=panel.example.com   # defaults to PANEL_DOMAIN, then BASE_DOMAIN
# MAIL_FROM=notifications@panel.example.com
# MAIL_REPLY_TO=admin@example.com   # replies go here; the sender has no mailbox
# BUNDLED_SMTP_HOST=127.0.0.1     # the production compose file sets this to "postfix"
# BUNDLED_SMTP_PORT=25
# Only if your host blocks outbound port 25: relay through any SMTP provider
# (Resend, Postmark, SES, Mailgun, ...). The user and password go together.
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false         # true for implicit TLS (port 465)
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASS=
# Admin accounts are root-equivalent on the host, so they are NOT resettable by
# email unless you opt in here.
# ALLOW_ADMIN_EMAIL_RESET=false
