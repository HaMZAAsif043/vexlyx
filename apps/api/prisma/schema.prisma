/// Prisma schema for Vexlyx — open-source hybrid hosting control panel.
/// Defines all core models: users, projects, deployments, domains, databases, and mail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Roles available to panel users.
enum Role {
  ADMIN
  USER
  RESELLER
}

/// Named capabilities (F5.19) that can be granted to a user on top of their
/// role. Additive only — a permission never removes what a user's role
/// already grants them.
enum Permission {
  canManageDns
  canManageFirewall
  canManageBackups
  canCreateSubAccounts
}

/// Supported project/application types for deployment.
enum ProjectType {
  NODEJS
  NEXTJS
  PYTHON
  REACT
  STATIC
  PHP
  WORDPRESS
  DOCKER
}

/// Lifecycle status of a hosted project.
enum ProjectStatus {
  CREATING
  ACTIVE
  STOPPED
  ERROR
  DELETED
}

enum GitHubConnectionStatus {
  CONNECTED
  DISCONNECTED
  SUSPENDED
  REPOSITORY_REMOVED
}

/// Status of a single deployment attempt.
enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  RUNNING
  FAILED
  CANCELLED
}

/// Verification/routing status of a custom domain.
enum DomainStatus {
  PENDING
  ACTIVE
  ERROR
}

/// Who serves DNS for a domain: the user's own registrar/DNS provider (CONNECTED)
/// or Vexlyx's CoreDNS after nameserver delegation (MANAGED).
enum DnsMode {
  CONNECTED
  MANAGED
}

/// Supported database engines that users can provision.
enum DatabaseType {
  POSTGRESQL
  MYSQL
}

/// Lifecycle status of a user-provisioned Redis instance (F5.30).
enum RedisInstanceStatus {
  CREATING
  RUNNING
  STOPPED
  ERROR
}

/// Durability mode of a Redis instance (F5.30): no persistence, RDB
/// snapshots, or append-only file.
enum RedisPersistence {
  NONE
  RDB
  AOF
}

/// Status of a user-provisioned mailbox.
enum MailboxStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Type of SSL/TLS certificate attached to a domain.
enum CertType {
  LETS_ENCRYPT
  CUSTOM
  SELF_SIGNED
}

/// Lifecycle and health status of an SSL certificate.
enum CertStatus {
  PENDING
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  ERROR
}

/// Lifecycle status of a full-system backup snapshot.
enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// How a backup snapshot was initiated.
enum BackupTrigger {
  SCHEDULED
  MANUAL
}

/// Status of a Docker cleanup run (F5.15).
enum CleanupStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// How a Docker cleanup run was initiated (F5.15).
enum CleanupTrigger {
  SCHEDULED
  MANUAL
  REDEPLOY
}

/// Status of a scheduled task run (F5.28).
enum ScheduledTaskRunStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED
}

/// How a scheduled task run was triggered (F5.28).
enum ScheduledTaskRunTrigger {
  SCHEDULED
  MANUAL
}

/// Transport protocol a firewall rule applies to.
enum FirewallProtocol {
  TCP
  UDP
}

/// Whether a firewall rule allows or denies matching traffic.
enum FirewallAction {
  ALLOW
  DENY
}

/// UFW default policy for a traffic direction.
enum FirewallPolicy {
  ALLOW
  DENY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A panel user who can own projects, domains, databases, and mailboxes.
model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  password            String
  role                Role         @default(USER)
  /// Reseller (User.id) that owns this account, when this user is a
  /// reseller-created sub-account. Null for admins, resellers themselves,
  /// and directly-registered users.
  resellerId          String?      @map("reseller_id")
  /// Per-resource creation caps; null means unlimited. maxSubAccounts only
  /// applies to RESELLER users.
  maxProjects         Int?         @map("max_projects")
  maxDomains          Int?         @map("max_domains")
  maxDatabases        Int?         @map("max_databases")
  maxMailboxes        Int?         @map("max_mailboxes")
  maxSubAccounts      Int?         @map("max_sub_accounts")
  maxScheduledTasks   Int?         @map("max_scheduled_tasks")
  maxRedisInstances   Int?         @map("max_redis_instances")
  /// Named capabilities granted on top of the role (F5.19). Additive only —
  /// never removes what the role itself already grants.
  permissions         Permission[] @default([])
  /// Reseller-only (F5.20): when true, this reseller's sub-account quotas may
  /// nominally sum above the reseller's own limit. Enforcement switches from
  /// nominal-sum (checked when a reseller sets sub-account quotas) to real
  /// aggregate usage across the reseller + all sub-accounts (checked at
  /// resource-creation time). ADMIN-only to toggle.
  oversellingEnabled  Boolean      @default(false) @map("overselling_enabled")
  totpSecretEncrypted String?      @map("totp_secret_encrypted")
  totpEnabled         Boolean      @default(false) @map("totp_enabled")
  totpVerifiedAt      DateTime?    @map("totp_verified_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  quotaNotices        QuotaNotice[]
  projects            Project[]
  domains             Domain[]
  databases           Database[]
  redisInstances      RedisInstance[]
  mailboxes           Mailbox[]
  virtualAliases      VirtualAlias[]
  dkimKeys            DkimKey[]
  sftpUser            SftpUser?
  scheduledTasks      ScheduledTask[]
  githubInstallations GitHubInstallation[]
  reseller            User?                @relation("ResellerAccounts", fields: [resellerId], references: [id], onDelete: SetNull)
  subAccounts         User[]               @relation("ResellerAccounts")

  @@index([resellerId])
  @@map("users")
}

/// A server-side session for authenticated users.
/// Primary lookup via Redis; PostgreSQL stores for audit and admin invalidation.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Single-use password reset token (F5.23). Only the SHA-256 of the emailed
/// token is stored, so a database read never yields a usable link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  requestIp String?   @map("request_ip")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Remembers that a quota warning was already emailed (F5.23), so it fires
/// once per threshold crossing rather than on every request. The row is
/// removed when usage drops back under the threshold.
model QuotaNotice {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  resource   String
  level      Int
  notifiedAt DateTime @default(now()) @map("notified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, level])
  @@map("quota_notices")
}

/// A hosted application or website managed by the panel.
/// Project names are unique per user.
model Project {
  id                String        @id @default(cuid())
  name              String
  type              ProjectType
  status            ProjectStatus @default(CREATING)
  gitUrl            String?       @map("git_url")
  branch            String        @default("main")
  buildCmd          String?       @map("build_cmd")
  startCmd          String?       @map("start_cmd")
  port              Int?
  /// HMAC-SHA256 secret for GitHub/GitLab webhook signature verification (F2.7).
  /// Generated once on first git connect; stored as a 64-char hex string.
  webhookSecret     String?       @map("webhook_secret")
  /// Ed25519 public key in OpenSSH authorized_keys format.
  /// Stored here so the dashboard can display it without touching disk.
  sshPublicKey      String?       @map("ssh_public_key")
  /// Absolute path to the Ed25519 private key on the host filesystem.
  /// Used by git_manager.py at clone/pull time via GIT_SSH_COMMAND.
  sshPrivateKeyPath String?       @map("ssh_private_key_path")
  githubInstallationId String?    @map("github_installation_id")
  githubRepoId         BigInt?    @map("github_repo_id")
  githubRepoFullName   String?    @map("github_repo_full_name")
  githubConnectionStatus GitHubConnectionStatus? @map("github_connection_status")
  githubDisconnectReason String?  @map("github_disconnect_reason")
  userId            String        @map("user_id")
  /// Docker container ID of the currently running container (short or full hash).
  containerId       String?       @map("container_id")
  /// Last known container status reported by Docker (running, exited, etc.).
  containerStatus   String?       @map("container_status")
  /// Host port dynamically allocated for this container (8100–8999).
  internalPort      Int?          @map("internal_port")
  /// Traefik-resolved hostname for this project (e.g. myapp.vexlyx.local).
  deployedDomain    String?       @map("deployed_domain")
  /// Timestamp of the most recent successful deployment.
  deployedAt        DateTime?     @map("deployed_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments        Deployment[]
  envVars            EnvVar[]
  domains            Domain[]
  databases          Database[]
  redisInstances     RedisInstance[]
  scheduledTasks     ScheduledTask[]
  githubInstallation GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@index([githubInstallationId])
  @@index([githubRepoId])
  @@map("projects")
}

model GitHubApp {
  id                     String   @id @default("singleton")
  appId                  BigInt   @unique @map("app_id")
  slug                   String
  clientId               String   @map("client_id")
  encryptedClientSecret  String   @map("encrypted_client_secret")
  encryptedPrivateKey    String   @map("encrypted_private_key")
  encryptedWebhookSecret String   @map("encrypted_webhook_secret")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("github_apps")
}

model GitHubInstallation {
  id                  String   @id @default(cuid())
  installationId      BigInt   @unique @map("installation_id")
  accountId           BigInt   @map("account_id")
  accountLogin        String   @map("account_login")
  accountType         String   @map("account_type")
  repositorySelection String   @map("repository_selection")
  status              GitHubConnectionStatus @default(CONNECTED)
  suspendedAt         DateTime? @map("suspended_at")
  disconnectedAt      DateTime? @map("disconnected_at")
  userId              String   @map("user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
  @@index([accountId])
  @@map("github_installations")
}

/// A single deployment attempt for a project (build + deploy lifecycle).
model Deployment {
  id         String           @id @default(cuid())
  status     DeploymentStatus @default(QUEUED)
  commitHash String?          @map("commit_hash")
  commitMsg  String?          @map("commit_msg")
  buildLogs  String?          @map("build_logs")
  duration   Int?
  projectId  String           @map("project_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("deployments")
}

/// An encrypted environment variable belonging to a project.
/// Values are encrypted with AES-256-GCM at rest.
model EnvVar {
  id        String   @id @default(cuid())
  key       String
  value     String
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("env_vars")
}

/// A custom domain attached to a user's project.
/// Includes SSL and verification status.
model Domain {
  id                String       @id @default(cuid())
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  sslEnabled        Boolean      @default(false) @map("ssl_enabled")
  /// CONNECTED = DNS stays with the user's provider; MANAGED = Vexlyx CoreDNS is authoritative (F5.23).
  dnsMode           DnsMode      @default(CONNECTED) @map("dns_mode")
  /// Unique verification token expected in DNS TXT record for domain ownership validation (F3.1).
  verificationToken String?      @map("verification_token")
  /// Optional path prefix routing (e.g. /api or /blog)
  pathPrefix        String?      @map("path_prefix")
  /// Parent domain ID if this domain is a subdomain of another registered domain (F3.2)
  parentId          String?      @map("parent_id")
  userId            String       @map("user_id")
  projectId         String?      @map("project_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent         Domain?        @relation("DomainSubdomains", fields: [parentId], references: [id], onDelete: Cascade)
  subdomains     Domain[]       @relation("DomainSubdomains")
  dnsRecords     DnsRecord[]
  mailboxes      Mailbox[]
  virtualAliases VirtualAlias[]
  dkimKeys       DkimKey[]
  certificate    Certificate?

  @@index([userId])
  @@index([parentId])
  @@map("domains")
}

/// An SSL/TLS certificate attached to a custom domain.
model Certificate {
  id            String     @id @default(cuid())
  domainId      String     @unique @map("domain_id")
  type          CertType   @default(LETS_ENCRYPT)
  status        CertStatus @default(PENDING)
  issuer        String?
  commonName    String     @map("common_name")
  sans          String[]   @default([])
  validFrom     DateTime?  @map("valid_from")
  validTo       DateTime?  @map("valid_to")
  autoRenew     Boolean    @default(true) @map("auto_renew")
  forceHttps    Boolean    @default(true) @map("force_https")
  certPath      String?    @map("cert_path")
  keyPath       String?    @map("key_path")
  encryptedKey  String?    @map("encrypted_key")
  serialNumber  String?    @map("serial_number")
  errorMessage  String?    @map("error_message")
  lastCheckedAt DateTime?  @map("last_checked_at")
  lastRenewedAt DateTime?  @map("last_renewed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([validTo])
  @@map("certificates")
}

/// A DNS record belonging to a domain zone.
model DnsRecord {
  id        String   @id @default(cuid())
  type      String
  name      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  weight    Int?
  port      Int?
  domainId  String   @map("domain_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@map("dns_records")
}

/// A user-provisioned database instance (MySQL or PostgreSQL).
model Database {
  id         String       @id @default(cuid())
  name       String
  type       DatabaseType
  host       String
  port       Int
  dbUser     String       @map("db_user")
  dbPassword String       @map("db_password")
  userId     String       @map("user_id")
  projectId  String?      @map("project_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@map("databases")
}

/// A user-provisioned Redis instance (F5.30): one dedicated container per
/// instance on the internal network, with a password, a memory cap and its
/// own volume. The panel's own Redis (sessions/queues) is never modeled here.
model RedisInstance {
  id                String              @id @default(cuid())
  name              String
  /// Compose-independent unique container name (vexlyx-redis-<slug>-<rand>).
  containerName     String              @map("container_name")
  /// Pinned image reference (e.g. valkey/valkey:8.0) — never `latest`.
  imageTag          String              @map("image_tag")
  memoryLimitMb     Int                 @map("memory_limit_mb")
  /// Redis maxmemory-policy (e.g. noeviction, allkeys-lru).
  evictionPolicy    String              @map("eviction_policy")
  persistence       RedisPersistence    @default(RDB)
  /// AES-256-GCM ciphertext (utils/encryption.ts); never returned by list
  /// endpoints and never written to logs or the audit log.
  passwordEncrypted String              @map("password_encrypted")
  status            RedisInstanceStatus @default(CREATING)
  userId            String              @map("user_id")
  projectId         String?             @map("project_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@map("redis_instances")
}

/// An email mailbox associated with a domain.
model Mailbox {
  id        String        @id @default(cuid())
  address   String        @unique
  password  String
  quota     Int           @default(1024)
  status    MailboxStatus @default(ACTIVE)
  userId    String        @map("user_id")
  domainId  String        @map("domain_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain            Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  vacationResponder VacationResponder?

  @@index([userId])
  @@index([domainId])
  @@map("mailboxes")
}

/// A Postfix virtual alias forwarding one address to one or more destinations.
/// A catch-all is stored with `source` = "@domain.com" (no local part).
model VirtualAlias {
  id           String   @id @default(cuid())
  source       String   @unique
  destinations String[]
  isCatchAll   Boolean  @default(false) @map("is_catch_all")
  userId       String   @map("user_id")
  domainId     String   @map("domain_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domainId])
  @@map("virtual_aliases")
}

enum DkimKeyStatus {
  ACTIVE
  RETIRING
  RETIRED
}

/// A DKIM selector/key pair for a domain (F4.8). Rotation keeps the previous
/// selector's row (and its published DNS TXT record) around in RETIRING
/// status so in-flight signed mail using the old key still validates while
/// the new selector's DNS TXT record propagates. Nothing auto-transitions
/// RETIRING -> RETIRED; an admin removes the old DNS record manually once
/// propagation is confirmed.
model DkimKey {
  id        String        @id @default(cuid())
  domainId  String        @map("domain_id")
  userId    String        @map("user_id")
  selector  String
  status    DkimKeyStatus @default(ACTIVE)
  publicKey String        @map("public_key") @db.Text
  keyLength Int           @default(2048) @map("key_length")
  createdAt DateTime      @default(now()) @map("created_at")
  retiredAt DateTime?     @map("retired_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([domainId, selector])
  @@index([domainId])
  @@index([userId])
  @@map("dkim_keys")
}

/// A vacation / out-of-office automated responder configured for a mailbox.
/// Generates Dovecot Pigeonhole Sieve scripts on incoming delivery (F4.7).
model VacationResponder {
  id           String    @id @default(cuid())
  mailboxId    String    @unique @map("mailbox_id")
  enabled      Boolean   @default(false)
  subject      String    @default("Out of office: Auto-reply")
  message      String    @db.Text
  intervalDays Int       @default(1) @map("interval_days")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@map("vacation_responders")
}

/// SFTP account for a panel user — chrooted to their projects directory.
/// One account per Vexlyx user; scoped to /opt/vexlyx/projects/{userId}/
model SftpUser {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  /// Linux username in format vsftp_<cuid_prefix>
  linuxUsername     String   @unique @map("linux_username")
  /// AES-256-GCM encrypted password stored for display-on-demand only
  encryptedPassword String?  @map("encrypted_password")
  /// List of SSH public keys in authorized_keys format
  sshPublicKeys     String[] @default([]) @map("ssh_public_keys")
  isEnabled         Boolean  @default(true) @map("is_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sftp_users")
}

/// A point-in-time snapshot of server-level resource metrics.
/// Collected every 60 seconds by the BullMQ metrics-collector job (F5.2).
/// BigInt used for RAM and disk byte counts to safely handle large servers.
model MetricSnapshot {
  id         String   @id @default(cuid())
  cpuPercent Float    @map("cpu_percent")
  ramUsed    BigInt   @map("ram_used")
  ramTotal   BigInt   @map("ram_total")
  diskUsed   BigInt   @map("disk_used")
  diskTotal  BigInt   @map("disk_total")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([recordedAt])
  @@map("metric_snapshots")
}

/// A full-system backup snapshot (F5.3): projects, databases, mail, and DNS
/// bundled into one archive on disk under BACKUPS_DIR, with a manifest of
/// what's inside so individual items can be restored later.
model BackupSnapshot {
  id          String        @id @default(cuid())
  status      BackupStatus  @default(PENDING)
  trigger     BackupTrigger
  /// Absolute path to the <id>.tar.gz archive on the host filesystem.
  archivePath String?       @map("archive_path")
  sizeBytes   BigInt?       @map("size_bytes")
  /// Index of archived items (projects/databases/mail/dns) plus the DNS
  /// records themselves, embedded directly since Postgres is their source
  /// of truth and they're small enough not to need archive extraction.
  manifest    Json?
  error       String?
  startedAt   DateTime      @default(now()) @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("backup_snapshots")
}

/// Singleton row (id is always "default") holding the configurable backup
/// schedule and retention policy, editable from the dashboard without a
/// redeploy.
model BackupSettings {
  id              String   @id @default("default")
  scheduleCron    String   @default("0 3 * * *") @map("schedule_cron")
  retentionDaily  Int      @default(7) @map("retention_daily")
  retentionWeekly Int      @default(4) @map("retention_weekly")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("backup_settings")
}

/// Singleton row (F5.15): scheduled Docker cleanup config, off by default.
model CleanupSettings {
  id                 String   @id @default("default")
  scheduleEnabled    Boolean  @default(false) @map("schedule_enabled")
  scheduleCron       String   @default("0 4 * * *") @map("schedule_cron")
  pruneAfterRedeploy Boolean  @default(false) @map("prune_after_redeploy")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("cleanup_settings")
}

/// A record of one Docker cleanup run (F5.15): manual, scheduled, or
/// triggered automatically after a redeploy's old image is confirmed safe
/// to remove.
model CleanupRun {
  id                String         @id @default(cuid())
  trigger           CleanupTrigger
  status            CleanupStatus  @default(RUNNING)
  containersRemoved Int?           @map("containers_removed")
  imagesRemoved     Int?           @map("images_removed")
  reclaimedBytes    BigInt?        @map("reclaimed_bytes")
  error             String?
  startedAt         DateTime       @default(now()) @map("started_at")
  completedAt       DateTime?      @map("completed_at")

  @@index([startedAt])
  @@map("cleanup_runs")
}

/// A user-defined scheduled task (cron job) that runs a command inside a
/// project's container (F5.28).
model ScheduledTask {
  id                  String    @id @default(cuid())
  projectId           String    @map("project_id")
  userId              String    @map("user_id")
  name                String
  command             String    @db.Text
  schedule            String // 5-field cron expression
  timeoutSeconds      Int       @default(300) @map("timeout_seconds")
  enabled             Boolean   @default(true)
  notifyOnFailure     Boolean   @default(true) @map("notify_on_failure")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastRunAt           DateTime? @map("last_run_at")
  nextRunAt           DateTime? @map("next_run_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs    ScheduledTaskRun[]

  @@index([projectId])
  @@index([userId])
  @@index([enabled])
  @@map("scheduled_tasks")
}

/// A single execution record of a scheduled task (F5.28).
model ScheduledTaskRun {
  id         String                  @id @default(cuid())
  taskId     String                  @map("task_id")
  trigger    ScheduledTaskRunTrigger
  status     ScheduledTaskRunStatus
  exitCode   Int?                  @map("exit_code")
  output     String?                 @db.Text // capped at 64KB
  startedAt  DateTime                @default(now()) @map("started_at")
  finishedAt DateTime?               @map("finished_at")

  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([startedAt])
  @@map("scheduled_task_runs")
}

/// A single UFW allow/deny rule (F5.4), mirrored to the host firewall via
/// firewall_manager.py every time it's created or deleted. Postgres is the
/// audit trail (who added what, when); UFW itself is the enforcement point.
model FirewallRule {
  id        String           @id @default(cuid())
  port      Int
  protocol  FirewallProtocol
  /// CIDR or single IP the rule matches; null means "anywhere".
  source    String?
  action    FirewallAction
  comment   String?
  createdBy String           @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([port, protocol])
  @@map("firewall_rules")
}

/// Singleton row (id is always "default") holding the configurable server
/// timezone (F5.13) — governs the backup cron's `tz` option and, optionally,
/// how timestamps are displayed across the dashboard. Defaults to the
/// server's detected local timezone but is overridable from Settings.
model SystemSettings {
  id        String   @id @default("default")
  timezone  String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Singleton row (id is always "default") holding UFW's default policy for
/// incoming/outgoing traffic, editable from the dashboard.
model FirewallSettings {
  id              String         @id @default("default")
  defaultIncoming FirewallPolicy @default(DENY) @map("default_incoming")
  defaultOutgoing FirewallPolicy @default(ALLOW) @map("default_outgoing")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("firewall_settings")
}

/// Generic audit trail (F5.18) for security/admin-sensitive mutations: role
/// and quota changes, user create/delete, firewall rule/policy changes,
/// backup restore/delete, and create/delete for projects/domains/databases/
/// mailboxes. Written only via AuditLogService.log() — never a public write
/// endpoint. `actorId` intentionally has no FK relation and `actorEmail`/
/// `actorRole` are a denormalized snapshot captured at write time, so an
/// entry stays legible even after the actor's account is later deleted.
/// `metadata` only ever holds an explicit whitelist of changed fields that
/// each call site assembles — never a raw request/response body — so it can
/// never contain a password, DB credential, or other secret.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email")
  actorRole  Role     @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
